{
  "redirects": [
    { "source": "/scaffold", "destination": "/backroom", "permanent": false },
    { "source": "/design", "has": [{ "type": "host", "value": "www.cargroff.com" }], "destination": "https://scaffold.cargroff.com/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "scaffold.cargroff.com" }], "destination": "/Carter%20Groff%20Design.html" },
    { "source": "/favicon.ico", "has": [{ "type": "host", "value": "scaffold.cargroff.com" }], "destination": "/assets/scaffold-favicon.ico" },
    { "source": "/apple-touch-icon.png", "has": [{ "type": "host", "value": "scaffold.cargroff.com" }], "destination": "/assets/scaffold-icon-180.png" },
    { "source": "/favicon.ico", "destination": "/assets/scaffold-favicon.ico" },
    { "source": "/apple-touch-icon.png", "destination": "/assets/scaffold-icon-180.png" },
    { "source": "/", "destination": "/Carter%20Portfolio.html" },
    { "source": "/backroom", "destination": "/Scaffold%20Hub.html" },
    { "source": "/docket", "destination": "/The%20Docket.html" },
    { "source": "/business", "destination": "/Business%20Hub.html" },
    { "source": "/design", "destination": "/Carter%20Groff%20Design.html" },
    { "source": "/api/health", "destination": "/api/design-brief" }
  ],
  "functions": {
    "api/design-brief.js": { "maxDuration": 30 },
    "api/brief-reply.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/design-brief", "schedule": "17 13 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*).jsx",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(design|portfolio).js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
