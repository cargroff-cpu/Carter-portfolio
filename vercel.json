{
  "rewrites": [
    { "source": "/", "destination": "/Carter%20Portfolio.html" },
    { "source": "/scaffold", "destination": "/Scaffold%20Hub.html" },
    { "source": "/docket", "destination": "/The%20Docket.html" },
    { "source": "/wick", "destination": "/Wick.html" },
    { "source": "/business", "destination": "/Business%20Hub.html" },
    { "source": "/design", "destination": "/Carter%20Groff%20Design.html" }
  ],
  "functions": {
    "api/wick-chat.js": { "includeFiles": "brand/**" },
    "api/wick-close-session.js": { "includeFiles": "brand/**" },
    "api/content-generate.js": { "includeFiles": "brand/**" }
  },
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*).jsx",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/wick-dock.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
