{
  "rewrites": [
    {
      "source": "/api/back-room-read",
      "destination": "/api/scaffold-write"
    },
    {
      "source": "/api/brief-triage",
      "destination": "/api/scaffold-write?op=triage"
    },
    {
      "source": "/api/logout",
      "destination": "/api/login?op=logout"
    },
    {
      "source": "/api/health",
      "destination": "/api/design-brief"
    },
    {
      "source": "/",
      "destination": "/Carter%20Portfolio.html"
    },
    {
      "source": "/back-room",
      "destination": "/Back%20Room.html"
    },
    {
      "source": "/docket",
      "destination": "/The%20Docket.html"
    },
    {
      "source": "/wick",
      "destination": "/Wick.html"
    },
    {
      "source": "/business",
      "destination": "/Business%20Hub.html"
    },
    {
      "source": "/design",
      "destination": "/The%20Scaffold.html"
    }
  ],
  "redirects": [
    {
      "source": "/scaffold",
      "destination": "/back-room",
      "permanent": false
    },
    {
      "source": "/Scaffold%20Hub.html",
      "destination": "/back-room",
      "permanent": false
    },
    {
      "source": "/Carter%20Groff%20Design.html",
      "destination": "/design",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "17 9 * * *"
    }
  ],
  "functions": {
    "api/wick-chat.js": {
      "includeFiles": "brand/**"
    },
    "api/content-generate.js": {
      "includeFiles": "brand/**"
    }
  },
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).jsx",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/design.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/wick-dock.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
